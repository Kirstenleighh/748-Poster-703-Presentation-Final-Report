# TRIMMING 

# Bash script for trimming and fastqc (First 200 samples of PRJEB75460):

#!/bin/bash

# define directories 
BASE_DIR=~/Projects/PRJEB75460/human_gut_metagenome
TRIM_DIR=~/Projects/PRJEB75460/Trimmed_reads
TRIM_FASTQC_DIR=~/Projects/PRJEB75460/fastqc_trimmed

mkdir -p "$TRIM_DIR" "$TRIM_FASTQC_DIR" # make directories if needed

cd "$BASE_DIR" # cd into base directory where raw reads are 

for DIR in $(ls -d SAMEA* | head -n 200); do # for SAMEA directories, process first 200

    echo "Processing $DIR"

    for R1 in "$DIR"/*_1.fastq.gz; do # for read 1
        [ -e "$R1" ] || continue

        R2=${R1/_1.fastq.gz/_2.fastq.gz} # find matching R2 read

        echo "Trimming $R1 and $R2"

        trim_galore \ # run TrimGalore on the paired end reads
            --paired \
            --quality 20 \ # remove low quality bases from read ends
            --output_dir "$TRIM_DIR" \ # write fastq files into trim dir
            "$R1" "$R2"

    done

done

```
# FastQC & MultiQC on Trimmed Reads
```
fastqc "$TRIM_DIR"/*.fq.gz -o "$TRIM_FASTQC_DIR"

multiqc	
