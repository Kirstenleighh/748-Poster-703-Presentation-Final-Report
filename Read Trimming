# Trimming remaining samples from PRJEB75460:

# Open a screen session

screen -S parallel_trimming_11-06-26
 
# Activate conda environment and install GNU parallel

conda activate [ENV NAME]  #conda activate trimming
conda install -c conda-forge parallel # install parallel into trimming env
 
# Navigate to 775 folder

# Run Trim Galore
# parallel runs the command simultaneously
# input file is tab separated
# -j 10 indicates max number of jobs is 10 at a time
# --cores 8 is the number of cpu cores, 10 jobs and 8 cores gives 80 CPU cores
# --paired is needed for paired end reads
# --quality 20 is the trimming threshold
# :::: indicates where the inputs are e.g. in a specified file, useful if you have a list of samples that still need trimming

parallel --colsep "\t" -j 10 "trim_galore --cores 8 --paired --quality 20 ~kirsten/Projects/PRJEB75460/human_gut_metagenome/*/{1}_1.fastq.gz ~kirsten/Projects/PRJEB75460/human_gut_metagenome/*/{1}_2.fastq.gz" :::: kirsten_remaining.tab


# PRJEB75462:

# Open a screen session

screen -S 62trimming
 
# Activate conda environment and install GNU parallel

conda activate [ENV NAME]  #conda activate trimming
conda install -c conda-forge parallel
 
# Navigate to PRJEB75462 folder

# Make sample list for samples in the subset 

find ~/Projects/PRJEB75462/PRJEB75462_subset1000 -mindepth 2 -maxdepth 2 -name "*_1.fastq.gz" | awk -F'/' '{dir=$(NF-1); file=$NF; sub(/_1\.fastq\.gz$/, "", file); print dir, file}' > sample_list.txt

# Run Trim Galore

parallel --colsep ' ' -j 10 'trim_galore --cores 8 --paired --quality 20 ~/Projects/PRJEB75462/PRJEB75462_subset1000/{1}/{2}_1.fastq.gz ~/Projects/PRJEB75462/PRJEB75462_subset1000/{1}/{2}_2.fastq.gz' :::: sample_list.txt


# Find the trimmed reads:
find ~/Projects/PRJEB75462/PRJEB75462_subset1000 -name "*_val_*.fq.gz" | head

# Count/check progress:
find ~/Projects/PRJEB75462/PRJEB75462_subset1000 -name "*_val_*.fq.gz" | wc -l


