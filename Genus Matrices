# Genus Matrices 
# extract genus level read counts and convert into rel abundance
# combining all samples to create a genus by sample matrix 

# import packages
import os
import glob
import pandas as pd


# Output directory

output_dir = "/pub60/kirsten/Projects/Results1/Section_1_Heatmaps"
os.makedirs(output_dir, exist_ok=True) # don't show an error if dir already exists


# Kraken2 kreport locations for full cohort

kreport_dirs = {
    "60": [
        "/pub60/kirsten/Projects/PRJEB75460/kraken2_results_773_newdb",
        "/pub60/kirsten/Projects/PRJEB75460/kraken2_results_first200_newdb",
    ],

    "62": [
        "/pub60/kirsten/Projects/PRJEB75462/kraken2_results_newdb_62",
    ],

    "63": [
        "/pub60/kirsten/Projects/PRJEB75463/kraken2_results_newdb_63",
    ],
}


#expected sample numbers

expected_samples = {
    "60": 973,
    "62": 995,
    "63": 998,
}


# create genus matrix from kreport2 files

def make_genus_matrix(directories):

    sample_tables = [] # list for each samples series which contains index (genus names) and values (rel abundance)

    for directory in directories: # for each kraken2 directory 

        files = glob.glob(
            os.path.join(directory, "*.kreport2") # find all .kreport2 files and return a list of file paths
        )

        print()
        print(f"Reading {len(files)} kreport2 files from:") # print number of files found per dir
        print(directory)

        for f in files: # for each sample

            sample = os.path.basename(f).replace( # extract sample name from file name (to be made into column names in matrix)
                ".kreport2",
                ""
            )

            rows = [] # list for genus and read count from individual samples 

            with open(f, "r") as infile: # read .kreport2

                for line in infile: # line by line

                    fields = line.rstrip("\n").split("\t") # split lines tab separated 

                    if len(fields) < 6: # make sure each line in the kreport contains 6 columns, if not skip
                        continue

                    # Kraken2 report columns:
                    #
                    # 0 = percentage
                    # 1 = clade reads
                    # 2 = direct reads
                    # 3 = taxonomic rank
                    # 4 = taxonomy ID
                    # 5 = taxon name

                    rank = fields[3] # extract taxonomic rank

                    # Keep genus-level entries only
                    if rank == "G":

                        genus = fields[5].strip() # remove white space

                        try:
                            clade_reads = int(fields[1]) # convert clade read into integer, skip if cannot be done
                        except ValueError:
                            continue

                        rows.append(
                            [genus, clade_reads] # store genus and clade read count for each sample 
                        )

            # Check that this sample contained genus entries, if not skip (doesnt include it in matrix)

            if not rows:

                print(
                    f"WARNING: no genus entries found in {f}"
                )

                continue

            # Convert genus and read counts to dataframe

            df = pd.DataFrame(
                rows,
                columns=[
                    "name",
                    "reads"
                ]
            )

            # Combine duplicate genus names

            df = (
                df.groupby("name")["reads"]
                .sum()
            )

            # Convert to relative abundance for final matrix

            total_reads = df.sum()

            if total_reads > 0: # make sure total is greater than 0 

                df = df / total_reads

            # Sample name becomes column name
            df.name = sample

            sample_tables.append(df) # add sample genus abundance to list of samples

    # Combine all samples

    if not sample_tables:

        raise RuntimeError( # stop script and give error if no valid samples were found
            "No valid kreport2 files containing genus "
            "entries were found."
        )

    matrix = pd.concat( # combine all samples into genus by sample matrix 
        sample_tables,
        axis=1
    ).fillna(0)

    return matrix


# process each bioproject

for cohort, directories in kreport_dirs.items():

    print()
    print(f"PROCESSING PRJEB754{cohort}")

    genus_matrix = make_genus_matrix(
        directories
    )

    # matrix info

    n_genera = genus_matrix.shape[0] # number of rows for genera
    n_samples = genus_matrix.shape[1] # number of columns for samples

    print()
    print(
        f"Genus matrix dimensions: "
        f"{n_genera} genera x {n_samples} samples"
    )

    # check sample numbers

    expected = expected_samples[cohort]

    if n_samples == expected:

        print(
            f"Sample count correct: {n_samples}"
        )

    else:

        print(
            f"WARNING: expected {expected} samples "
            f"but found {n_samples}"
        )

    # Check for duplicate sample names

    duplicate_samples = genus_matrix.columns[
        genus_matrix.columns.duplicated()
    ]

    if len(duplicate_samples) > 0:

        print()
        print(
            "WARNING: duplicate sample names detected:"
        )

        print(
            list(duplicate_samples)
        )

    else:

        print(
            "No duplicate sample names."
        )

    # Save full genus matrix

    outfile = os.path.join(
        output_dir,
        f"kraken_genus_matrix_{cohort}.csv"
    )

    genus_matrix.to_csv(
        outfile
    )

    print()
    print(
        f"Saved genus matrix:"
    )

    print(
        outfile
    )


# print summary when finished 
print()
print("ALL THREE GENUS MATRICES COMPLETE")
