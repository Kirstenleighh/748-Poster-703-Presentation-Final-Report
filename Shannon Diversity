# Alpha diversity
# Shannon
# using .bracken files

#!/bin/bash

# output file
OUTPUT="/pub60/kirsten/Projects/Results1/Section_2_diversity/alpha_diversity_shannon_all.csv"

# Path to Alpha diversity python script 
ALPHA_SCRIPT="/pub60/kirsten/Projects/PRJEB75460/alphadiversity.py"

echo "sample,cohort,shannon" > "$OUTPUT" # output to csv, sample id, bioproject and shannon diversity value


# PRJEB75460 - FIRST 200

echo "Processing PRJEB75460 first 200"

# loop through each .bracken file in the results dir
for FILE in /pub60/kirsten/Projects/PRJEB75460/Bracken_newdb_200_results/*.bracken
do
    SAMPLE=$(basename "$FILE" .bracken) # extract sample name from filename

    VALUE=$(python "$ALPHA_SCRIPT" \ # run alphadiversity.py script on current .bracken file 
        -f "$FILE" \ # .bracken as the input
        -a Sh | grep -oP '(?<=: )[\d.]+') # Sh for shannon diversity, output piped into grep to extract the number after :, shannon value is stored in VALUE

    echo "${SAMPLE},PRJEB75460,${VALUE}" >> "$OUTPUT" # add as a row to output
done


# PRJEB75460 - 773

echo "Processing PRJEB75460 - 773..."

for FILE in /pub60/kirsten/Projects/PRJEB75460/Bracken_newdb_773_results/*.bracken
do
    SAMPLE=$(basename "$FILE" .bracken)

    VALUE=$(python "$ALPHA_SCRIPT" \
        -f "$FILE" \
        -a Sh | grep -oP '(?<=: )[\d.]+')

    echo "${SAMPLE},PRJEB75460,${VALUE}" >> "$OUTPUT"
done


# PRJEB75462

echo "Processing PRJEB75462..."

for FILE in /pub60/kirsten/Projects/PRJEB75462/Bracken_results_newdb_62/*.bracken
do
    SAMPLE=$(basename "$FILE" .bracken)

    VALUE=$(python "$ALPHA_SCRIPT" \
        -f "$FILE" \
        -a Sh | grep -oP '(?<=: )[\d.]+')

    echo "${SAMPLE},PRJEB75462,${VALUE}" >> "$OUTPUT"
done


# PRJEB75463

echo "Processing PRJEB75463..."

for FILE in /pub60/kirsten/Projects/PRJEB75463/Bracken_results_newdb_63/*.bracken
do
    SAMPLE=$(basename "$FILE" .bracken)

    VALUE=$(python "$ALPHA_SCRIPT" \
        -f "$FILE" \
        -a Sh | grep -oP '(?<=: )[\d.]+')

    echo "${SAMPLE},PRJEB75463,${VALUE}" >> "$OUTPUT"
done


# Check sample counts and shannon results for each bioproject

echo "SHANNON RESULTS"

for COHORT in PRJEB75460 PRJEB75462 PRJEB75463
do
    COUNT=$(grep -c "$COHORT" "$OUTPUT")
    echo "$COHORT: $COUNT samples"
done

echo ""
echo "Output:"
echo "$OUTPUT"
