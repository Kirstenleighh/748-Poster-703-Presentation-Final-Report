# Species heatmaps for top 50 most abundant, in the 3 seperate bioprojects

# import python packages needed 
import os
import glob
import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt


# directories

output_dir = "/pub60/kirsten/Projects/Results1/Section_1_Heatmaps"
os.makedirs(output_dir, exist_ok=True)


# Bracken directories for input bracken files
bracken_dirs = {
    "60": [
        "/pub60/kirsten/Projects/PRJEB75460/Bracken_newdb_773_results",
        "/pub60/kirsten/Projects/PRJEB75460/Bracken_newdb_200_results",
    ],
    "62": [
        "/pub60/kirsten/Projects/PRJEB75462/Bracken_results_newdb_62",
    ],
    "63": [
        "/pub60/kirsten/Projects/PRJEB75463/Bracken_results_newdb_63",
    ],
}


# Existing species matrices
species_matrices = {
    "60": "/pub60/kirsten/Projects/PRJEB75460/bracken_species_matrix_60.csv",
    "62": "/pub60/kirsten/Projects/PRJEB75462/bracken_species_matrix_62.csv",
    "63": "/pub60/kirsten/Projects/PRJEB75463/bracken_species_matrix_63.csv",
}


# create full genus matrix from bracken files
def make_genus_matrix(directories):

    tables = [] # list to store genus level abundance table from each bracken file

    for directory in directories: # in each bracken output dir for this bioproject

        files = glob.glob(os.path.join(directory, "*.bracken")) # find all .bracken files

        print(f"Reading {len(files)} Bracken files from:")
        print(directory)

        for f in files: # for each .bracken file

            sample = os.path.basename(f).replace(".bracken", "") # extract sample name from filename

            df = pd.read_csv(f, sep="\t") # read .bracken as tab separated

            # Keep genus-level assignments
            df = df[df["taxonomy_lvl"] == "G"][
                ["name", "fraction_total_reads"]
            ].copy()

            # Remove duplicate genus names if present
            df = df.drop_duplicates("name")

            # Taxa as rows
            df = df.set_index("name")

            # Sample as column
            df.columns = [sample]

            tables.append(df) # add sample table to list

    # Combine all samples columns using genus names as row index
    matrix = pd.concat(tables, axis=1).fillna(0) # any missing values given 0

    return matrix


# top 50 species heatmaps

def make_heatmap(matrix, cohort, level):

    # Select top 50 by mean abundance

    top50 = (
        matrix.mean(axis=1) # mean abundance of each taxon across all samples in matrix
        .sort_values(ascending=False) # sort from highest to lowest mean abundance
        .head(50) # keep top 50 with highest mean rel abundance
        .index
    )

    top_matrix = matrix.loc[top50].copy() # extract these 50 from original matrix

    if level == "species": # species level 
        top_matrix.index = (
            top_matrix.index
            .str.replace(r"\s*\([^)]*\)", "", regex=True) # remove any additional characters e.g. strain information
            .str.strip()
        )

    # Save matrix

    top_matrix_file = os.path.join(
        output_dir,
        f"PRJEB754{cohort}_{level}_top50_matrix.tsv"
    )

    top_matrix.to_csv(
        top_matrix_file,
        sep="\t"
    )

    # Log transform for plotting, log10

    plot_matrix = np.log10(top_matrix + 1e-6) # 1e-6 included to avoid log10(0) undefined values for plot

    # Plot heatmap

    plt.figure(figsize=(20, 14)) # figure sizes

    sns.heatmap( # seaborn used to draw heatmap
        plot_matrix,
        cmap="Blues", # colour scale, lighter colours for lower values, darker for higher
        xticklabels=False, # no sample names as too many
        yticklabels=True, # display species names on y axis
        cbar_kws={ # colour bar label
            "label": "log10(relative abundance + 1e-6)"
        }
    )

    plt.title(
        f"PRJEB754{cohort}: Top 50 most abundant {level}",
        fontsize=18
    )

    plt.xlabel("Samples", fontsize=16)
    plt.ylabel(level.capitalize(), fontsize=16)

    plt.yticks(fontsize=12)
    plt.xticks(fontsize=12)

    # Save figure

    outfile = os.path.join(
        output_dir,
        f"PRJEB754{cohort}_{level}_top50_heatmap.png"
    )

    plt.savefig(
        outfile,
        dpi=300,
        bbox_inches="tight"
    )

    plt.close()

    print(f"Saved: {outfile}")


# process species
print()
print("SPECIES HEATMAPS")

for cohort, matrix_file in species_matrices.items(): # for each bioproject, loop through their species matrix

    print()
    print(f"Reading species matrix for cohort {cohort}")
    print(matrix_file)

    matrix = pd.read_csv(
        matrix_file,
        index_col=0 # first column should contain names to be used as row index
    )

    print(
        f"Matrix dimensions: "
        f"{matrix.shape[0]} taxa x {matrix.shape[1]} samples" # 0 is number of species, 1 is number of samples
    )

    make_heatmap(
        matrix,
        cohort,
        "species"
    )


# Process genus matrices

print()
print("Genus matrices and heatmaps")

for cohort, directories in bracken_dirs.items(): # for each bioproject, loop into the bracken directory

    print()
    print(f"Processing genus matrix for cohort {cohort}")

