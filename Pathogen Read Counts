# Pathogen read counts .tsv file


#!/bin/bash

set -euo pipefail # exits if a command fails, undefined variables are treated as errors

# output directory and file 
OUTDIR="/pub60/kirsten/Projects/Results1/Section_3_pathogens"
OUTFILE="${OUTDIR}/pathogen_read_counts.tsv"

# Pathogen list: pathogen name and TaxID
PATHOGENS=(
"Clostridioides difficile|1496"
"Clostridium perfringens|1502"
"Escherichia coli O157|1045010"
"Campylobacter jejuni|197"
"Listeria monocytogenes|1639"
"Salmonella enterica serovar Enteritidis|149539"
"Shigella sonnei|624"
"Yersinia enterocolitica|630"
"Vibrio cholerae|666"
"Giardia duodenalis|5741"
"Cryptosporidium parvum|5807"
"Cyclospora cayetanensis|88456"
"Human adenovirus F|130309"
)

# Header
printf "Cohort\tSample\tPathogen\tTaxID\tBracken_read_count\n" > "$OUTFILE"

process_reports() { # processing bracken reports

    local cohort="$1" # first argument passed to function to be stored in 'cohort'
    shift # removes this to leave dir paths only

    for dir in "$@"; do # for every dir in function

        find "$dir" -type f -name '*.breport' -print0 | # search for .breport files
        while IFS= read -r -d '' report; do # read each .breport 

            sample=$(basename "$report" .breport) # extract filename without dir and .breport extension

            for entry in "${PATHOGENS[@]}"; do # for each pathogen

                pathogen="${entry%%|*}" # extract everything before the | (pathogen name)
                taxid="${entry##*|}" # extract everything after the | (taxa id)

                # Kraken/Bracken report columns:
                # $1 = percentage
                # $2 = reads assigned to clade
                # $3 = reads assigned directly to this taxon
                # $4 = rank
                # $5 = TaxID
                # $6+ = taxon name

                count=$(awk -v taxid="$taxid" ' # awk reads current bracken report
                    $5 == taxid { # for each line, check that it contains the tax id required
                        print $3 # if so print column 3 (number of reads assigned to the taxon)
                        found=1 # record that the taxon was found
                        exit # stop search and exit once a match has been found
                    }
                    END {
                        if (!found) print 0 # if not found print 0
                    }
                ' "$report")

                printf "%s\t%s\t%s\t%s\t%s\n" \ # write output to tsv with the 5 columns:
                    "$cohort" \
                    "$sample" \
                    "$pathogen" \
                    "$taxid" \
                    "$count" \
                    >> "$OUTFILE"

            done # check all pathogens for the sample

        done # finsih processing all .breports in the dir

    done # finish processing all directories in function
}


# check each sample against the 13 pathogens:

# process prjeb75460 breports
process_reports \
    "PRJEB75460" \
    "/pub60/kirsten/Projects/PRJEB75460/Bracken_newdb_200_results" \
    "/pub60/kirsten/Projects/PRJEB75460/Bracken_newdb_773_results"

# process prjeb75462 breports
process_reports \
    "PRJEB75462" \
    "/pub60/kirsten/Projects/PRJEB75462/Bracken_results_newdb_62"

# process prjeb75463 breports
process_reports \
    "PRJEB75463" \
    "/pub60/kirsten/Projects/PRJEB75463/Bracken_results_newdb_63"


echo "Finished."
echo "Output: $OUTFILE"
