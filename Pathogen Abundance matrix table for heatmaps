# pathogen abundances for heatmaps 

#!/usr/bin/env python3

# import modules/packages 
import os
import glob
import pandas as pd


# 13 target pathogens
# create a dictionary that matches the pathogens to their ncbi ids

pathogens = {
    "Clostridioides difficile": 1496,
    "Clostridium perfringens": 1502,
    "Escherichia coli": 562,
    "Campylobacter jejuni": 197,
    "Listeria monocytogenes": 1639,
    "Salmonella enterica": 28901,
    "Shigella sonnei": 624,
    "Yersinia enterocolitica": 630,
    "Vibrio cholerae": 666,
    "Giardia duodenalis": 5741,
    "Cryptosporidium parvum": 5807,
    "Cyclospora cayetanensis": 88456,
    "Human adenovirus F": 130309
}

taxid_to_pathogen = { # reverse search dictionary
    str(taxid): pathogen # convert taxid to string
    for pathogen, taxid in pathogens.items()
}


# Bracken directories 

cohort_dirs = { # dictionary for bracken results, location for each bioproject

    "PRJEB75460": [
        "/pub60/kirsten/Projects/PRJEB75460/Bracken_newdb_200_results",
        "/pub60/kirsten/Projects/PRJEB75460/Bracken_newdb_773_results"
    ],

    "PRJEB75462": [
        "/pub60/kirsten/Projects/PRJEB75462/Bracken_results_newdb_62"
    ],

    "PRJEB75463": [
        "/pub60/kirsten/Projects/PRJEB75463/Bracken_results_newdb_63"
    ]
}


# Output directory

output_dir = (
    "/pub60/kirsten/Projects/Results1/"
    "Section_3_pathogens/heatmap"
)

os.makedirs(output_dir, exist_ok=True) # create output dir if it doesnt already exist


# Process all Bracken files 

all_records = [] # list to store record for bioproject, sample and pathogen, each sample should have 13 records 

for cohort, directories in cohort_dirs.items(): # for each bioproject, loop through the bracken directory 

    files = [] # list to store the bracken files for this bioproject

    for directory in directories: # find every .bracken file in current dir
        files.extend(
            glob.glob(
                os.path.join(directory, "*.bracken") # join each directory/*.bracken 
            )
        )

    # Remove duplicate paths
    files = sorted(set(files))

    print(f"{cohort}: found {len(files)} Bracken files") # report how many .bracken files were found for this bioproject 

    for filepath in files: # for each sample .bracken

        sample = os.path.basename(filepath).replace( # extract file name from full path, and remove .bracken extension, leaving sample id only
            ".bracken", ""
        )

        # Read Bracken file

        try:

            df = pd.read_csv(
                filepath,
                sep="\t" # read as tab separated 
            )

        except Exception as e: # if cant be read, print wanring and skip to next bracken file 

            print(
                f"WARNING: could not read {filepath}"
            )
            print(e)
            continue

        # Check required columns 

        required_columns = {
            "taxonomy_id",
            "new_est_reads",
            "fraction_total_reads"
        }

        if not required_columns.issubset(df.columns): # should return true if all columns exist

            print(
                f"WARNING: required columns missing in "
                f"{filepath}"
            )

            continue # skip to next file if not 


        # Convert TaxID to string

        df["taxonomy_id"] = (
            df["taxonomy_id"]
            .astype(str)
            .str.strip()
        )

        # Create dictionary containing pathogen results
        # for this sample

        sample_hits = {} # dictionary of pathogens detected in current sample

        for _, row in df.iterrows(): # for each row in bracken df

            taxid = str(row["taxonomy_id"]) # extract taxonomy id as string

            if taxid in taxid_to_pathogen: # if one of the selected pathogens

                pathogen = taxid_to_pathogen[taxid] # convert to pathogen name from id 

                sample_hits[pathogen] = {
                    "Bracken_read_count":
                        int(row["new_est_reads"]), # store est read count

                    "Relative_abundance":
                        float(row["fraction_total_reads"]) # store rel abundance
                }

        # Create ALL 13 pathogen rows even if absent

        for pathogen, taxid in pathogens.items(): # loop through the list of 13 pathogens, each sample will have 13 rows regardless of presence/absence

            if pathogen in sample_hits: # if pathogen is present in bracken file, record values:

                read_count = sample_hits[pathogen][
                    "Bracken_read_count"
                ]

                relative_abundance = sample_hits[pathogen][
                    "Relative_abundance"
                ]

            else: # if not present, values are 0

                read_count = 0
                relative_abundance = 0.0

            all_records.append({ # add the complete sample record (13 rows) to all records

                "Cohort": cohort,

                "Sample": sample,

                "Pathogen": pathogen,

                "TaxID": taxid,

                "Bracken_read_count":
                    read_count,

                "Relative_abundance":
                    relative_abundance
            })


# Create dataframe 

complete = pd.DataFrame(all_records) # the list of dictionaries then becomes one df, with each dictionary being one row


if complete.empty: # if no records, stop script

    raise RuntimeError(
        "No records were generated. "
        "Check the Bracken directories."
    )


# Sort data

cohort_order = [
    "PRJEB75460",
    "PRJEB75462",
    "PRJEB75463"
]

pathogen_order = list(pathogens.keys()) # keep to pathogen order of the list the same as the dictionary

complete["Cohort"] = pd.Categorical( # order the bioprojects 60, 62 and 63
    complete["Cohort"],
    categories=cohort_order,
    ordered=True
)

complete["Pathogen"] = pd.Categorical( # order the pathogens 
    complete["Pathogen"],
    categories=pathogen_order,
    ordered=True
)

complete = complete.sort_values( # sort table in order, bioproject, sample, pathogen
    ["Cohort", "Sample", "Pathogen"]
)


# Save long format table 

long_output = os.path.join(
    output_dir,
    "13_pathogens_relative_abundance_long.tsv"
)

complete.to_csv(
    long_output,
    sep="\t", # save as tab separated
    index=False
)

print()
print(
    f"Saved long table: {long_output}"
)


# Create wide relative abundance table 

wide = complete.pivot_table( # convert long format table into wide format
    index="Pathogen", # rows as pathogens
    columns=["Cohort", "Sample"], # columns as bioproject and sample
    values="Relative_abundance",
    fill_value=0, # any missing values become 0
    observed=False
)

wide = wide.reindex(
    pathogen_order # reorder rows to match the order of the pathogen list that was defined before 
)


# Flatten multi-level column names

wide.columns = [
    f"{cohort}_{sample}"
    for cohort, sample in wide.columns
]


# Save wide format table 

wide_output = os.path.join(
    output_dir,
    "13_pathogens_relative_abundance_wide.tsv"
)

wide.to_csv(
    wide_output,
    sep="\t"
)

print(
    f"Saved wide table: {wide_output}"
)


# Create log10 table 
# converting rel abundance from a fraction to RPM value (reads per million)
# log10(1 + RPM)

log_wide = wide * 1_000_000

import numpy as np # import numpy for log transformation

log_wide = np.log10(1 + log_wide)


# Save log10 table 

log_output = os.path.join(
    output_dir,
    "13_pathogens_log10_relative_abundance.tsv"
)

log_wide.to_csv(
    log_output,
    sep="\t"
)

print(
    f"Saved log10 table: {log_output}"
)


# Check sample counts per bioproject

print()
print("SAMPLE COUNTS")

sample_counts = (
    complete[
        ["Cohort", "Sample"]
    ]
    .drop_duplicates()
    .groupby("Cohort", observed=False)
    .size()
)

print(sample_counts)


# Total sample count

total_samples = (
    complete[
        ["Cohort", "Sample"]
    ]
    .drop_duplicates()
    .shape[0]
)

print()
print(
    f"Total unique samples: {total_samples}"
)


# Expected sample counts

expected = {
    "PRJEB75460": 973,
    "PRJEB75462": 995,
    "PRJEB75463": 998
}

print()
print("EXPECTED VS ACTUAL")

for cohort in cohort_order: # for each bioproject

    actual = sample_counts.get(cohort, 0) # retrieve count, return 0 if absent

    print(
        f"{cohort}: "
        f"expected={expected[cohort]}, "
        f"actual={actual}"
    )


# Check total number of rows

expected_rows = 2966 * 13

actual_rows = len(complete)

print()
print(
    f"Expected pathogen rows: {expected_rows}"
)

print(
    f"Actual pathogen rows:   {actual_rows}"
)

